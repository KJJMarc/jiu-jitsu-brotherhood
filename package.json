{
  "name": "jiu-jitsu-brotherhood",
  "version": "0.1.0",
  "private": true,
  "description": "Jiu Jitsu Brotherhood website (Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "generate:migration-ledger": "node scripts/generate-migration-ledger.mjs",
    "test:routing": "tsx scripts/test-phase-2b-routing.ts",
    "test:content": "tsx scripts/test-phase-2e-content.ts",
    "test:resend": "node --env-file=.env.local --import tsx scripts/test-resend-email.ts",
    "import:jjb-contents": "tsx scripts/import-jjb-contents.ts",
    "import:jjb-contents:write": "tsx scripts/import-jjb-contents.ts --write",
    "import:jjb-past-events": "node --env-file=.env.local --import tsx scripts/import-jjb-past-events.ts --write",
    "import:jjb-past-events:dry-run": "node --env-file=.env.local --import tsx scripts/import-jjb-past-events.ts",
    "import:articles": "node --env-file=.env.local scripts/import-articles.mjs",
    "import:articles:dry-run": "node --env-file=.env.local scripts/import-articles.mjs --dry-run",
    "import:shopify": "node scripts/import-shopify-catalogue.mjs --apply",
    "import:shopify:dry-run": "node scripts/import-shopify-catalogue.mjs",
    "import:jjb-keep": "node --env-file=.env.local scripts/import-jjb-keep-catalogue.mjs --apply",
    "import:jjb-keep:dry-run": "node --env-file=.env.local scripts/import-jjb-keep-catalogue.mjs",
    "import:jjb-event-tickets": "node --env-file=.env.local scripts/import-jjb-event-ticket-drafts.mjs --apply",
    "import:jjb-event-tickets:dry-run": "node --env-file=.env.local scripts/import-jjb-event-ticket-drafts.mjs",
    "import:inventory": "node scripts/apply-shopify-inventory.mjs --apply",
    "import:inventory:dry-run": "node scripts/apply-shopify-inventory.mjs",
    "import:physical-drafts": "node scripts/import-physical-inventory-drafts.mjs --apply",
    "import:physical-drafts:dry-run": "node scripts/import-physical-inventory-drafts.mjs",
    "seed:manual-physical-drafts": "node scripts/seed-manual-physical-drafts.mjs --apply",
    "seed:manual-physical-drafts:dry-run": "node scripts/seed-manual-physical-drafts.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.116.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "leaflet": "^1.9.4",
    "next": "^15.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "resend": "^6.28.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "csv-parse": "^5.6.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "sharp": "^0.33.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3"
  }
}
