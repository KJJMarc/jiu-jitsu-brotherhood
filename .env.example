# Kingston Jiu Jitsu — environment variables

# Dedicated KJJ Supabase project (NOT Dojo Director).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Server-only. Never prefix with NEXT_PUBLIC_. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional public site origin for Auth redirect emails (invite + password reset).
# Prefer the canonical production URL in production. Preview deploys can omit this
# and fall back to https://$VERCEL_URL.
# Also add these to Supabase → Authentication → URL Configuration → Redirect URLs:
#   https://www.kingstonjiujitsu.com/admin/auth/confirm/
#   https://www.kingstonjiujitsu.com/admin/auth/callback/
# NEXT_PUBLIC_SITE_URL=https://www.kingstonjiujitsu.com

# Public article data source: "json" (default, news.json) or "supabase".
# Keep "json" until the Supabase import has been verified on Preview.
ARTICLES_SOURCE=json

# Public managed pages (policies / kids info): "supabase" (default) or "static".
# Default serves published Admin → Pages body_html when present, otherwise the
# in-repo static copy. Set to "static" only to force the in-repo fallback.
PAGES_SOURCE=supabase

# --- Admin Dashboard GA4 reporting (server-only) ---
# Numeric GA4 Property ID (Admin → Property settings), NOT the G- Measurement ID.
# Example Kingston Jiu Jitsu property: 360613226
GA4_PROPERTY_ID=360613226
# Full Google Cloud service-account JSON (one line / minified).
# Never use NEXT_PUBLIC_*. Never commit real keys.
# Also used for Search Console reporting (same service account).
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com",...}

# --- Admin Dashboard Search Console reporting (server-only) ---
# Domain property as shown in Search Console, e.g. sc-domain:kingstonjiujitsu.com
# Optional when GA4_SERVICE_ACCOUNT_JSON is set (defaults to that domain property).
# SEARCH_CONSOLE_SITE_URL=sc-domain:kingstonjiujitsu.com


# --- Store transactional email (server-only, Resend) ---
# Never use NEXT_PUBLIC_*. Never commit real keys.
# From address: Kingston Jiu Jitsu <noreply@send.kingstonjiujitsu.com>
# Reply-To / admin notify: admin@kingstonjiujitsu.com
# RESEND_API_KEY=re_xxxxxxxx

# --- Store payments (server-only, Mollie TEST) ---
# Must be a TEST key (test_…). Live keys are blocked in this phase.
# MOLLIE_API_KEY=test_xxxxxxxx
