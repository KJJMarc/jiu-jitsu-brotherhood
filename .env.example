# Jiu Jitsu Brotherhood — environment variables

# Dedicated JJB Supabase project. Do not reuse Kingston Jiu Jitsu credentials.
# Create a NEW Supabase project for Jiu Jitsu Brotherhood before setting these.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Must match the project ref in NEXT_PUBLIC_SUPABASE_URL before migrations/import --write.
# JJB_SUPABASE_PROJECT_REF=YOUR_PROJECT_REF

# Optional comma-separated refs that must never be used (e.g. known KJJ production).
# JJB_SUPABASE_BLOCKLIST_REFS=

# Server-only. Never prefix with NEXT_PUBLIC_. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional public site origin for Auth redirect emails (invite + password reset).
# Prefer the canonical production URL in production. Preview deploys can omit this
# and fall back to https://$VERCEL_URL.
# Also add these to Supabase → Authentication → URL Configuration → Redirect URLs:
#   https://www.jiujitsubrotherhood.com/admin/auth/confirm/
#   https://www.jiujitsubrotherhood.com/admin/auth/callback/
# NEXT_PUBLIC_SITE_URL=https://www.jiujitsubrotherhood.com

# Public article data source: "json" (default) or "supabase".
# Phase 1 does not publish the cloned KJJ news.json archive.
ARTICLES_SOURCE=json

# Public managed pages (policies): "supabase" (default) or "static".
# Default serves published Admin → Pages body_html when present, otherwise the
# in-repo static copy. Set to "static" only to force the in-repo fallback.
PAGES_SOURCE=supabase

# --- Admin Dashboard GA4 reporting (server-only) ---
# Numeric GA4 Property ID (Admin → Property settings), NOT the G- Measurement ID.
# Use a JJB property. Do not copy Kingston Jiu Jitsu IDs.
# GA4_PROPERTY_ID=
# Full Google Cloud service-account JSON (one line / minified).
# Never use NEXT_PUBLIC_*. Never commit real keys.
# Also used for Search Console reporting (same service account).
# GA4_SERVICE_ACCOUNT_JSON=

# --- Admin Dashboard Search Console reporting (server-only) ---
# Domain property as shown in Search Console, e.g. sc-domain:jiujitsubrotherhood.com
# SEARCH_CONSOLE_SITE_URL=

# --- Store transactional email (server-only, Resend) ---
# Never use NEXT_PUBLIC_*. Never commit real keys.
# Do not invent a JJB sending domain. Set verified Resend values when available.
# STORE_EMAIL_FROM=
# STORE_EMAIL_REPLY_TO=
# STORE_ADMIN_ORDER_NOTIFY_TO=
# RESEND_API_KEY=

# --- Store payments (server-only, Mollie) ---
# Use a TEST key (test_…) unless MOLLIE_ALLOW_LIVE=true in Production.
# MOLLIE_API_KEY=test_xxxxxxxx
# MOLLIE_ALLOW_LIVE=
